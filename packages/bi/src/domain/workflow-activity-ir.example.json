      ],
      "outputs": [
        "已验证的 Goal 候选"
      ],
      "sourceRef": "workflow-package/implementation/workflow.md §3 / IM-07–11"
    },
    {
      "id": "intake-research",
      "kind": "trigger",
      "from": {
        "flowId": "main",
        "nodeId": "intake"
      },
      "target": {
        "flowId": "research",
        "entryNodeId": "request",
        "exitNodeId": "return-source"
      },
      "condition": "缺少获准且可派生的事实",
      "resume": {
        "kind": "origin"
      },
      "inputs": [
        "事实缺口",
        "记录的 requesting Action"
      ],
      "outputs": [
        "研究事实与来源"
      ],
      "sourceRef": "workflow-package/implementation/workflow.md §3 / IM-01R"
    },
    {
      "id": "implement-research",
      "kind": "trigger",
      "from": {
        "flowId": "ladder",
        "nodeId": "implement"
      },
      "target": {
        "flowId": "research",
        "entryNodeId": "request",
        "exitNodeId": "return-source"
      },
      "condition": "缺少获准且可派生的事实",
      "resume": {
        "kind": "origin"
      },
      "inputs": [
        "事实缺口",
        "记录的 requesting Action"
      ],
      "outputs": [
        "研究事实与来源"
      ],
      "sourceRef": "workflow-package/implementation/workflow.md §3 / IM-01R"
    }
  ]
}
