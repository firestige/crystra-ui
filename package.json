{
  "name": "wsr-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.12.0",
    "npm": "11.6.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspace wsr-ui-core",
    "browser": "playwright test",
    "benchmark:full": "node qualification/panel-benchmark/v1/run-fixed.mjs",
    "benchmark:smoke": "node qualification/panel-benchmark/v1/run.mjs --mode=smoke",
    "deps:check": "node scripts/dependency-inventory.mjs --check",
    "deps:write": "node scripts/dependency-inventory.mjs --write",
    "dev": "vite packages/bi",
    "dev:test": "vite packages/bi --open /test.html",
    "docker:build": "docker build --tag wsr-ui-bi:local .",
    "docker:smoke": "./scripts/docker-smoke.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "package:verify": "npm run build --workspace wsr-ui-core && node scripts/package-contract.mjs packages/bi && npm pack --dry-run --json --workspace wsr-ui-core",
    "react18:verify": "npm run build --workspace wsr-ui-core && node scripts/qualify-react18-consumer.mjs",
    "test": "vitest run && node --test scripts/*.test.mjs qualification/panel-benchmark/v1/*.test.mjs",
    "typecheck": "tsc -b --pretty false",
    "preview:workflow-layout": "node scripts/generate-workflow-activity-layouts.mjs"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.0",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/legacy-modes": "6.5.4",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.4",
    "@codemirror/view": "6.43.11",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.2",
    "@emnapi/wasi-threads": "1.2.3",
    "@eslint/js": "10.0.1",
    "@iconify-json/tabler": "1.2.38",
    "@iconify/tailwind4": "1.2.3",
    "@playwright/test": "1.62.1",
    "@shikijs/langs": "4.4.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/d3": "7.4.3",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "anser": "2.3.5",
    "clsx": "2.1.1",
    "elkjs": "0.12.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "jsdom": "29.1.1",
    "katex": "0.18.7",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-core-commonmark": "2.0.3",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-factory-space": "2.0.1",
    "micromark-util-character": "2.1.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-sanitize-uri": "2.0.1",
    "micromark-util-symbol": "2.0.1",
    "prettier": "3.9.6",
    "shiki": "4.4.3",
    "tslib": "2.8.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
