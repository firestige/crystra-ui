{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "types": ["vite/client"],
    "resolveJsonModule": true,
    "paths": {
      "crystra-ui-core": ["../../packages/bi/src/public.ts"]
    }
  },
  "include": ["**/*.tsx", "**/*.ts"]
}
