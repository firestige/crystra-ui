          "title": "状态历史",
          "width": 480,
          "height": 320,
          "status": null,
          "body": "<div class=\"history\"><div><span>执行 A</span><i class=\"g\"></i><i class=\"g\"></i><i class=\"a\"></i><i class=\"g\"></i></div><div><span>执行 B</span><i class=\"g\"></i><i class=\"a\"></i><i class=\"a\"></i><i class=\"g\"></i></div><div><span>执行 C</span><i class=\"g\"></i><i class=\"g\"></i><i class=\"g\"></i><i class=\"g\"></i></div></div><div class=\"axis\">10:00 <span>10:30</span>11:00</div><p class=\"muted\">绿色：正常　黄色：待关注</p>",
